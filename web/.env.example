# Application environment: local | staging | production
APP_ENV=local

# Database — staging/production must NOT point at seed/demo databases
DATABASE_URL=postgres://community_os:community_os@localhost:5432/community_os
# Netlify Database injects NETLIFY_DB_URL automatically; the app prefers it when set.
# NETLIFY_DB_URL=

# Auth.js / NextAuth
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# Optional: required on the one-time "Create first admin" form when set.
# After the first admin exists, registration is invite-only.
# BOOTSTRAP_SECRET=

# Optional invite email (Resend). Without this, admins copy the invite URL.
# RESEND_API_KEY=
# EMAIL_FROM=Community OS <noreply@your-domain.com>

# Google Drive sync (public folder API key OR service account)
# GOOGLE_DRIVE_API_KEY=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Document storage: local (dev) | s3 (staging/production)
STORAGE_PROVIDER=local
DOCUMENT_STORAGE_ROOT=./storage/documents

# S3-compatible object storage (required when STORAGE_PROVIDER=s3)
# Never commit real credentials.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Local demo only — ignored when APP_ENV is staging/production
DEMO_PASSWORD=willows-demo
ALLOW_DEMO_SEED=true
